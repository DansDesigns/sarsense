#!/bin/sh
### BEGIN INIT INFO
# Provides:          sarsense
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: SARSense Wi-Fi sensing hub
### END INIT INFO
# sysvinit script for Devuan and other systemd-free systems.

NAME=sarsense
DIR=/opt/sarsense
CONF=/etc/sarsense/sarsense.json
USER=sarsense
PIDFILE=/run/$NAME.pid
LOG=/var/log/$NAME.log
PYTHON=/usr/bin/python3

. /lib/lsb/init-functions

start() {
    log_daemon_msg "Starting SARSense hub" "$NAME"
    touch "$LOG" && chown "$USER" "$LOG"
    start-stop-daemon --start --quiet --background --make-pidfile --pidfile "$PIDFILE" \
        --chuid "$USER" --chdir "$DIR" --startas /bin/sh -- \
        -c "exec $PYTHON -m sarsense --config $CONF >>$LOG 2>&1"
    log_end_msg $?
}

stop() {
    log_daemon_msg "Stopping SARSense hub" "$NAME"
    start-stop-daemon --stop --quiet --retry TERM/10/KILL/5 --pidfile "$PIDFILE"
    rc=$?
    rm -f "$PIDFILE"
    log_end_msg $rc
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart|force-reload) stop; start ;;
    status) status_of_proc -p "$PIDFILE" "$PYTHON" "$NAME" ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 2 ;;
esac
